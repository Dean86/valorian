{
  "name": "@meridian/rating-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "NODE_OPTIONS=--experimental-sqlite tsx src/dev-node.ts",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute meridian --local --file=./schema.sql",
    "db:migrate": "wrangler d1 execute meridian --remote --file=./schema.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@meridian/rating-core": "*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.123.0"
  }
}
